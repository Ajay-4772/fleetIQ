# FleetIQ Environment Configuration Template
# Copy this file to .env for local overrides (never commit .env)

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL when using docker-compose, default dev uses H2 standalone)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fleetiq
DB_USER=fleetiq_user
DB_PASSWORD=fleetiq_secret

# AI / Jev Configuration
# When empty or unavailable, FleetIQ automatically uses deterministic rule-based fallback
JEV_API_ENABLED=false
JEV_API_KEY=
JEV_API_URL=https://api.jev.ai/v1/decisions
JEV_TIMEOUT_MS=3000
JEV_CONFIDENCE_THRESHOLD=0.85

# Synthetic Simulator Configuration
SIMULATOR_DEFAULT_SEED=20260925
SIMULATOR_DEFAULT_VEHICLE_COUNT=50
SIMULATOR_DEFAULT_EVENT_COUNT=250

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080
